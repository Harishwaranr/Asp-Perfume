# ─────────────────────────────────────────────────────────────
#  Asp Perfume — environment configuration
#  Copy this file to `.env` and fill in real values.
#  `.env` is git-ignored and must NEVER be committed.
# ─────────────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# ── Database ────────────────────────────────────────────────
# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/asp_perfume
# MongoDB Atlas (replace user, pass and cluster):
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/asp_perfume?retryWrites=true&w=majority

# ── JWT ─────────────────────────────────────────────────────
# Generate a strong random secret, do NOT invent one by hand:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=paste_your_generated_secret_here
JWT_EXPIRES_IN=7d

# ── CORS ────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call this API.
# 5500 = VS Code Live Server, 5000 = this server serving the frontend itself.
CLIENT_URLS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5000,http://127.0.0.1:5000

# ── Seed accounts (used only by `npm run seed`) ─────────────
SEED_ADMIN_EMAIL=admin@aspperfume.com
SEED_ADMIN_PASSWORD=change_this_to_a_strong_password
SEED_DEMO_PASSWORD=change_this_too_demo123

# ── Razorpay (OPTIONAL) ─────────────────────────────────────
# Leave BOTH blank to use the built-in simulated payment flow.
# Fill them in only when you want real payments. Get keys from
# https://dashboard.razorpay.com/app/keys — use rzp_test_* while developing.
# The SECRET must never appear in frontend code.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
